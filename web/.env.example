# PitchVision web app environment variables
# Copy this file to .env.local and fill in your values

# Backend connection
PV_BACKEND_URL=http://localhost:8000
PV_BACKEND_TOKEN=your-secret-token-here

# yt-dlp binary location (optional, defaults to "yt-dlp")
# YT_DLP_PATH=/usr/local/bin/yt-dlp

# Data directory (optional, defaults to web/data)
# PV_DATA_DIR=/app/web/data
